---
import { t, formatPrice, CURRENCY, localePath, type Locale } from '../data/i18n';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const price = product.price[CURRENCY[locale]];
const detailHref = localePath(locale, `products/${product.id}/`);
const state = product.checkoutUrl
  ? product.type === 'preorder'
    ? t('preorder', locale)
    : t('buy', locale)
  : t('soon', locale);
---

<article class="card">
  <a class="card-media" href={detailHref} aria-label={product.name[locale]}>
    {
      product.image ? (
        <img
          src={product.image}
          alt={product.name[locale]}
          width="900"
          height="900"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span aria-hidden="true">no image yet</span>
      )
    }
  </a>
  <div class="card-body">
    {product.type === 'preorder' && <span class="badge">{t('preorder', locale)}</span>}
    <h2 class="card-title">
      <a href={detailHref}>{product.name[locale]}</a>
    </h2>
    <span class="card-price">{formatPrice(price, locale)}</span>
    <p class="card-blurb">{product.blurb[locale]}</p>
    <div class="card-options">
      {product.options.map((o) => <span translate="no">{o}</span>)}
    </div>
    <a class="buy" href={detailHref}>{t('view', locale)}</a>
    <p class="card-state">{state}</p>
  </div>
</article>
